rules_version = '2';
// Rules for the desktop app's accounts (Firebase project set up by Ryan). Paste into Firestore > Rules.
// Each player's decks and profile (data/users/<uid>/...) are theirs alone; the ranked leaderboard
// (ranks/<uid>) is readable by everyone and writable only by its owner.
service cloud.firestore {
  match /databases/{database}/documents {
    match /data/users/{uid}/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /ranks/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
