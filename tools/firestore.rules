rules_version = '2';
// Rules for the desktop app's accounts (Firebase project set up by Ryan). Paste into Firestore > Rules.
// Each player's decks and profile (data/users/<uid>/...) are theirs alone. The ranked leaderboard (ranks/<uid>) is
// readable by everyone; its owner can only change it one game at a time: a loss lowers the bounty by at most 50,000,
// and a win raises it by 5,000 to 50,000 only with a match record (results/<match>) from the same season that the
// loser's own game wrote naming this player as the winner, which the winner marks as used so it counts once.
// Seasons are calendar quarters (s, like "2026q4"): moving to a new one at least halves the bounty (to 300,000 at
// most) and starts the record again; the first season keeps the bounty from before seasons.
service cloud.firestore {
  match /databases/{database}/documents {
    match /data/users/{uid}/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /results/{mid} {
      allow read: if request.auth != null;
      // only the loser writes the record, naming someone else as the winner
      allow create: if request.auth != null && request.resource.data.l == request.auth.uid
        && request.resource.data.w is string && request.resource.data.w != request.auth.uid && request.resource.data.c == 0;
      // the winner marks it used, with the win count it becomes
      allow update: if request.auth != null && resource.data.w == request.auth.uid && resource.data.c == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['c'])
        && request.resource.data.c == get(/databases/$(database)/documents/ranks/$(request.auth.uid)).data.w + 1;
    }
    // Shared match records for the Meta page: each signed-in player adds their own side of a finished match once
    // (their Leader, their opponent's, the result and their own decklist), and nobody can change them afterwards.
    match /games/{id} {
      allow read: if true;
      allow create: if request.auth != null && d().by == request.auth.uid
        && d().keys().hasOnly(['v', 't', 'm', 'k', 'f', 'l', 'o', 'r', 'y', 'tn', 'd', 'n', 'on', 'by', 'rp'])
        && d().r in ['w', 'l'] && d().l is string && d().l.size() <= 12 && d().d is string && d().d.size() <= 1300
        && d().t is int && d().t > request.time.toMillis() - 600000 && d().t < request.time.toMillis() + 600000
        && (!('rp' in d()) || exists(/databases/$(database)/documents/replays/$(id)));
    }
    // Shared replays: a replay code (or a finished match's replay for the Recent games feed, under its games id) holds the
    // same text as a replay file. Anyone can open one; only a signed-in player adds one, once, and nobody changes it.
    match /replays/{id} {
      allow read: if true;
      allow create: if request.auth != null && d().by == request.auth.uid && d().keys().hasOnly(['v', 't', 'by', 'e'])
        && d().e is string && d().e.size() <= 900000 && id.matches('^[a-z0-9-]{4,80}$')
        && d().t is int && d().t > request.time.toMillis() - 600000 && d().t < request.time.toMillis() + 600000;
    }
    match /ranks/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.b is int && request.resource.data.b >= 0 && request.resource.data.b <= 300000;
      allow update: if request.auth != null && request.auth.uid == uid && (isLoss() || isWin() || nameOnly() || newSeason());
    }
    function d() { return request.resource.data; }
    function o() { return resource.data; }
    function sameSeason() { return d().get('s', '') == o().get('s', '') && d().get('ps', {}) == o().get('ps', {}); }
    function nameOnly() { return sameSeason() && d().b == o().b && d().w == o().w && d().l == o().l; }
    function isLoss() { return sameSeason() && d().w == o().w && d().l == o().l + 1 && d().b <= o().b && d().b >= o().b - 50000 && d().b >= 0; }
    function isWin() {
      return sameSeason() && d().l == o().l && d().w == o().w + 1 && d().b >= o().b + 5000 && d().b <= o().b + 50000
        && get(/databases/$(database)/documents/results/$(d().lw)).data.w == request.auth.uid
        && get(/databases/$(database)/documents/results/$(d().lw)).data.c == d().w
        && get(/databases/$(database)/documents/results/$(d().lw)).data.s == d().s;
    }
    function newSeason() {
      return d().s is string && d().s.matches('^[0-9]{4}q[1-4]$') && d().get('ps', {}).size() <= 12 && (
        (!('s' in o()) && d().b == o().b && d().w == o().w && d().l == o().l)
        || ('s' in o() && d().s > o().s && d().w == 0 && d().l == 0 && d().b >= 0 && d().b <= o().b / 2 && d().b <= 300000));
    }
  }
}
